@model EditoraFormViewModel
@{
    ViewData["Title"] = "Nova editora";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Nova editora</h1>
        <p>Informe o nome comercial e o endereco da sede.</p>
    </div>
    <a class="botao botao-secundario" asp-action="Index">Voltar</a>
</div>

<div class="cartao">
    <form asp-action="Criar" method="post" class="formulario">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="campo">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome" class="validacao"></span>
        </div>

        <div class="campo campo-largo">
            <label asp-for="Endereco"></label>
            <input asp-for="Endereco" />
            <span asp-validation-for="Endereco" class="validacao"></span>
        </div>

        <div class="rodape-formulario">
            <button class="botao" type="submit">Cadastrar</button>
            <a class="botao botao-secundario" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
