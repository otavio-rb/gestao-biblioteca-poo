@model LivroFormViewModel
@{
    ViewData["Title"] = "Nova obra";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Nova obra</h1>
        <p>O ISBN e unico no catalogo e a obra precisa de ao menos um autor e uma editora.</p>
    </div>
    <a class="botao botao-secundario" asp-action="Index">Voltar</a>
</div>

<div class="cartao">
    <form asp-action="Criar" method="post" class="formulario">
        <partial name="_Formulario" model="Model" />
        <div class="rodape-formulario">
            <button class="botao" type="submit">Cadastrar</button>
            <a class="botao botao-secundario" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
