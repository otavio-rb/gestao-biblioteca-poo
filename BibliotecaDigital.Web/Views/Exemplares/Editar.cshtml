@model ExemplarFormViewModel
@{
    ViewData["Title"] = "Editar exemplar digital";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Editar exemplar digital</h1>
        <p>Obra: <strong>@Model.TituloLivro</strong></p>
    </div>
    <a class="botao botao-secundario" asp-controller="Livros" asp-action="Detalhes" asp-route-id="@Model.LivroId">Voltar</a>
</div>

<div class="cartao">
    <form asp-action="Editar" method="post" class="formulario">
        <partial name="_Formulario" model="Model" />
        <div class="rodape-formulario">
            <button class="botao" type="submit">Salvar alteracoes</button>
            <a class="botao botao-secundario" asp-controller="Livros" asp-action="Detalhes" asp-route-id="@Model.LivroId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
