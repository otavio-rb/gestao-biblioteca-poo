@model IEnumerable<BibliotecaDigital.Web.Models.Usuario>

@{
    ViewData["Title"] = "Gestao de Usuarios";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
        <h1>Gestao de Usuarios</h1>
        <p>Cadastro, permissoes e controle de bloqueio de leitores e administradores.</p>
    </div>
    <a asp-action="Criar" class="btn btn-primary">Novo usuario</a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div style="padding: 10px; background-color: #d4edda; color: #155724; border-radius: 6px; margin-bottom: 15px;">
        @TempData["Sucesso"]
    </div>
}
@if (TempData["Erro"] != null)
{
    <div style="padding: 10px; background-color: #f8d7da; color: #721c24; border-radius: 6px; margin-bottom: 15px;">
        @TempData["Erro"]
    </div>
}

<table class="table" style="width: 100%; border-collapse: collapse; background: #fff; border-radius: 8px; overflow: hidden;">
    <thead>
        <tr style="border-bottom: 1px solid #ddd; text-align: left;">
            <th style="padding: 12px;">ID</th>
            <th style="padding: 12px;">Nome</th>
            <th style="padding: 12px;">E-mail</th>
            <th style="padding: 12px;">Tipo</th>
            <th style="padding: 12px;">Endereco</th>
            <th style="padding: 12px;">Status</th>
            <th style="padding: 12px;">Acoes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 12px;">@usuario.Id</td>
                <td style="padding: 12px;">@usuario.Nome</td>
                <td style="padding: 12px;">@usuario.Email</td>
                <td style="padding: 12px;">@usuario.GetType().Name</td>
                <td style="padding: 12px;">@usuario.EnderecoResidencial</td>
                <td style="padding: 12px;">
                    @(usuario.EstaBloqueado ? "Bloqueado" : "Ativo")
                </td>
                <td style="padding: 12px;">
                    <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                        <a asp-action="Editar" asp-route-id="@usuario.Id">Editar</a>

                        @if (usuario.EstaBloqueado)
                        {
                            <form asp-action="Desbloquear" method="post" style="display: inline;">
                                <input type="hidden" name="id" value="@usuario.Id" />
                                <button type="submit">Desbloquear</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Bloquear" method="post" style="display: inline;">
                                <input type="hidden" name="id" value="@usuario.Id" />
                                <button type="submit">Bloquear</button>
                            </form>
                        }

                        <form asp-action="Excluir" method="post" style="display: inline;"
                              onsubmit="return confirm('Excluir @usuario.Nome?');">
                            <input type="hidden" name="id" value="@usuario.Id" />
                            <button type="submit">Excluir</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>